# ── Database (Prisma Postgres) ──────────────────────────────────────────────
# The same database the bot reads/writes petals to. From the Prisma Data
# Platform, or reuse the existing Virtual Atham database.
DATABASE_URL=""

# ── Discord bot / interactions endpoint ─────────────────────────────────────
# discord.com/developers/applications → your app → General Information
DISCORD_APPLICATION_ID=""   # "Application ID"
DISCORD_PUBLIC_KEY=""       # "Public Key" — verifies interaction signatures

# Bot → Settings → Bot → "Reset Token"
DISCORD_BOT_TOKEN=""

# Your server id — command registration targets this guild (instant).
# Leave blank to register commands globally (can take ~1h to appear).
DISCORD_GUILD_ID=""

# ── Completion announcement (optional) ──────────────────────────────────────
# When the final petal is painted, the bot posts a celebration. Set EITHER a
# webhook URL, OR the channel id (uses DISCORD_BOT_TOKEN to post).
DISCORD_WEBHOOK_URL=""
DISCORD_ANNOUNCEMENT_CHANNEL_ID=""
